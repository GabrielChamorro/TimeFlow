              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('dependencias y posiciones conservadas',()=>{const rows=pm.response.json(); const t=rows.find(t=>t.id===Number(pm.environment.get('task_c'))); pm.expect(t.dependenciaIds).to.include(Number(pm.environment.get('task_a'))); pm.expect(t.dependenciaIds).to.include(Number(pm.environment.get('task_b')));});",
              "pm.environment.set('task_a_version',pm.response.json().find(t=>t.id===Number(pm.environment.get('task_a'))).version);"
            ]
          }
        }
