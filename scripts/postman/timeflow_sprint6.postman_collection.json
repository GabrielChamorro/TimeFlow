              "pm.test('Contrato ligero sin datos sensibles',()=>{const r=pm.response.json();pm.expect(Array.isArray(r.tasks) && Number.isFinite(r.serverNowMs) && r.tasks.every(t => !('evidencia' in t) && !('bitacora' in t))).to.eql(true);});"
            ]
          }
        }
      ]
