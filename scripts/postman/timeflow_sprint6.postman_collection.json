  "item": [
    {
      "name": "Login administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{test_origin}}"
          },
          {
            "key": "X-TimeFlow-CSRF",
            "value": "1"
          }
        ],
        "url": "{{base_url}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{admin_email}}\", \"password\": \"{{admin_password}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('admin_token',pm.response.json().token);",
              "pm.test('JWT y usuario sin contraseñas',()=>{const r=pm.response.json(); pm.expect(r.token).to.be.a('string'); pm.expect(r.user).not.to.have.property('passwordHash'); pm.expect(r.user).not.to.have.property('password');});"
            ]
          }
        }
      ]
    },
